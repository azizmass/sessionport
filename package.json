{
  "name": "sessionport",
  "version": "0.1.3",
  "description": "Port AI coding sessions between tools — Claude Code ↔ OpenCode ↔ Codex. Export, import, compact, and migrate sessions with full fidelity.",
  "author": "Masmoudi Aziz <azizmasmoudi019@gmail.com>",
  "type": "module",
  "bin": {
    "sessionport": "dist/cli/index.js",
    "sp": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./ir/*": "./dist/ir/*.js",
    "./readers/*": "./dist/readers/*.js",
    "./render/*": "./dist/render/*.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azizmass/sessionport.git"
  },
  "keywords": [
    "claude",
    "opencode",
    "codex",
    "ai-sessions",
    "session-port",
    "claude-code",
    "migration",
    "export",
    "import"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check src/",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "@inquirer/prompts": "^5.0.0",
    "better-sqlite3": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "vitest": "^1.6.0",
    "prettier": "^3.3.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0"
  }
}
